@startuml
hide empty members

enum Player

class Board <<(T,lightblue)>>
<> MapEntry
Board *-down- "*" MapEntry
MapEntry -left-> Player :value
MapEntry -down-> Position :key

Game *- Board : board
Game --> Player : first
Game -> GameState : state
GameState <|-- Draw
GameState <|-- Run
GameState <|-- Win
Run o-up-> Player : turn
Win o-up-> Player : winner

